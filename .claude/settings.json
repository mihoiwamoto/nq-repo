{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/snapshot.py\" hook nqrepo-demo.html 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
