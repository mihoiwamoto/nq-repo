{
  "framework": null,
  "installCommand": "cd react-src && npm ci",
  "buildCommand": "sh .claude/build-vercel.sh",
  "outputDirectory": ".vercel-out",
  "cleanUrls": false,
  "redirects": [
    { "source": "/", "destination": "/react/admin/login?kit=1", "permanent": false }
  ],
  "rewrites": [
    { "source": "/snapshots/images/:path*", "destination": "/images/:path*" },
    { "source": "/snapshots/react/:name/:path*", "destination": "/snapshots/react/:name/index.html" },
    { "source": "/react/:path*", "destination": "/react/index.html" }
  ]
}
